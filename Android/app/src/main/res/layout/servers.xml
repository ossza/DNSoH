<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OSS Secure DNS Path ID"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:paddingBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter the 32-character path ID from your portal subscription, or the full URL."
        android:paddingBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="To get a path ID, visit portal.oss.co.za in your browser, register and subscribe."
        android:paddingBottom="12dp"
        android:textStyle="italic"/>

    <!-- Hidden radio group so existing Java still finds the IDs -->
    <RadioGroup
        android:id="@+id/pref_server_radio_group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
      <RadioButton
          android:id="@+id/pref_server_builtin"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"/>
      <RadioButton
          android:id="@+id/pref_server_custom"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"/>
    </RadioGroup>

    <Spinner
        android:id="@+id/builtin_server_spinner"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:entries="@array/names"/>

    <TextView
        android:id="@+id/server_description"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/server_website"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <!-- Visible path ID / URL field -->
    <EditText
        android:id="@+id/custom_server_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="32-character path ID or https://dns1.oss.co.za/..."
        android:inputType="textFilter|textUri"
        android:imeOptions="actionDone"
        tools:ignore="Autofill"/>

    <TextView
        android:id="@+id/url_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/server_choice_warning"
        android:textColor="@color/accent_bad"
        android:visibility="gone"/>

  </LinearLayout>
</ScrollView>
